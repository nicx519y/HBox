# Bootloader 相关配置
TARGET = HBox_bootloader
BUILD_DIR = build_bootloader

# 源文件目录
C_SOURCE_DIRS = \
Bootloader/Src \
Drivers/STM32H7xx_HAL_Driver/Src \
Drivers/QSPI-W25Q64 \
Drivers/USART \
Drivers/LED

# C++ 源文件目录
CPP_SOURCE_DIRS = \
Bootloader/Src

# 包含通用配置
include Makefile.common

# 添加 bootloader 特定的包含路径
C_INCLUDES += \
-IBootloader/Inc \
-IDrivers/USART \
-IDrivers/QSPI-W25Q64 \
-IDrivers/LED

# 自动查找源文件
C_SOURCES = $(foreach dir,$(C_SOURCE_DIRS),$(wildcard $(dir)/*.c))
CPP_SOURCES = $(foreach dir,$(CPP_SOURCE_DIRS),$(wildcard $(dir)/*.cpp))
ASM_SOURCES = Bootloader/Startup/startup_stm32h750xx_bootloader.s

# 目标文件
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(CPP_SOURCES:.cpp=.o)))
vpath %.cpp $(sort $(dir $(CPP_SOURCES)))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

# Bootloader 特定的链接脚本
LDSCRIPT = STM32H750XBHx_bootloader.ld

# 编译器标志
CXXFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections
CXXFLAGS += -fno-exceptions -fno-rtti

# 链接选项
LDFLAGS = $(MCU) -specs=nano.specs -specs=nosys.specs $(LIBS) -Wl,--gc-sections -u _printf_float
LDFLAGS += -flto -Wl,--gc-sections -Wl,--strip-debug

# 编译规则
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

$(BUILD_DIR):
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR)
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.cpp Makefile | $(BUILD_DIR)
	$(CXX) -c $(CXXFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.cpp=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	@$(CXX) $(OBJECTS) $(LDFLAGS) -T$(LDSCRIPT) -o $@
	@$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@

clean:
	@echo "Cleaning bootloader build files..."
	-if exist $(BUILD_DIR) rd /s /q $(BUILD_DIR)
	@echo "Clean complete"

print-debug:
	@echo "C_SOURCES = $(C_SOURCES)"
	@echo "CPP_SOURCES = $(CPP_SOURCES)"
	@echo "ASM_SOURCES = $(ASM_SOURCES)"
	@echo "OBJECTS = $(OBJECTS)"
	@echo "C_INCLUDES = $(C_INCLUDES)"
	@echo "Current directory: $(shell pwd)"

.PHONY: clean all print-debug

# 下载
flash:
	openocd \
	-d0 \
	-f Openocd_Script/ST-LINK-FLASH.cfg \
	-c init \
	-c halt \
	-c "reset halt" \
	-c "flash info 0" \
	-c "flash erase_sector 0 0 last" \
	-c "program $(BUILD_DIR)/$(TARGET).elf verify" \
	-c "reset run" \
	-c shutdown 

